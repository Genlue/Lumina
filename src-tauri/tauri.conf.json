{
  "productName": "Lumina",
  "version": "4.0.1",
  "identifier": "com.lumina.album",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-ui.mjs",
    "beforeBuildCommand": "node scripts/build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lumina",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/libheif/**/*": "libheif/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true
      }
    }
  }
}